# Copy this file to ".env" (same folder) and fill it in. Never commit .env.

# From https://developer.riotgames.com (development keys expire every 24 hours).
RIOT_API_KEY=RGAPI-xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# Your Riot ID exactly as shown in the client: GameName#TAG
RIOT_ID=YourName#NA1

# Regional routing for your server:
#   americas -> NA, BR, LAN, LAS
#   europe   -> EUW, EUNE, TR, RU, ME
#   asia     -> KR, JP
#   sea      -> OCE, SG/PH/TH/TW/VN
REGION=americas

# Optional settings
# PORT=8000
# SESSION_IDLE_HOURS=3
